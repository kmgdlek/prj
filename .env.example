# 이 파일을 복사해서 .env.local 로 이름을 바꾸고 값을 채우세요.
# VITE_ 로 시작하는 값만 브라우저에 들어갑니다 (공개돼도 되는 값만!)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# 아래는 서버(/api)에서만 쓰는 비밀 키 — 절대 VITE_ 를 붙이지 마세요
DATA_GO_KR_KEY=
# 이야기꾼 AI (Google Gemini, 무료). 키는 aistudio.google.com 의 'Get API key' 에서 받는다
GEMINI_API_KEY=
# 비워 두면 쓸 수 있는 가장 새 lite 모델부터 자동 선택 (무료 한도가 넉넉함). 직접 정하려면 모델 이름을 적는다
GEMINI_MODEL=
PIXABAY_KEY=
