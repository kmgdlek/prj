# 이 파일을 복사해서 .env.local 로 이름을 바꾸고 값을 채우세요.
# VITE_ 로 시작하는 값만 브라우저에 들어갑니다 (공개돼도 되는 값만!)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# 아래는 서버(/api)에서만 쓰는 비밀 키 — 절대 VITE_ 를 붙이지 마세요
DATA_GO_KR_KEY=
ANTHROPIC_API_KEY=
# 이야기꾼 AI 를 OpenAI 로 바꾸려면: OPENAI_API_KEY 를 채우고 AI_PROVIDER=openai (비워 두면 키가 있는 쪽, 둘 다 있으면 Claude)
OPENAI_API_KEY=
AI_PROVIDER=
OPENAI_MODEL=gpt-4o-mini
PIXABAY_KEY=
